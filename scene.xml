<!-- original scene.xml from universal_robots_ur5e scene in Mujoco menagerire Github-->
<mujoco model="UR5E Scene">
<!--  <include file="ur5e.xml"/>-->
  <include file="ur5e.xml"/>
  <include file="C:\Users\u3009531\PycharmProjects\PythonProject\mujoco_menagerie\robotiq_2f85\2f85.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>

  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <default>
    <default class="wall_contact">
      <geom solref="0.05 0.1" solimp="0.95 0.99 0.001"/>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <body name="conveyor_base" pos="0 0.7 0.08">
      <geom type="box" size="0.8 0.17 0.08" rgba="0.75 0.75 0.75 1"/>
    </body>

    <body name="belt" pos="0 0.7 0.16">
      <geom name="belt_geom" type="box"
        size="0.75 0.15 0.01"
        rgba="0 0.3 0 1"
        contype="1" conaffinity="1"
        friction="1.2 0.005 0.0001"
        solref="0.002 1"
        solimp="0.95 0.99 0.001"
        margin="0.001"
        gap="0" surfacevel="0.2 0 0"/>
      </body>

    <body name="box_body" pos="0 0.7 0.21">
      <freejoint name="box_joint"/>
      <inertial mass="0.05" pos="0 0 0"
           diaginertia="8e-5 8e-5 8e-5"/>
      <geom name="box_geom" type="box"
        size="0.03 0.03 0.03"
        rgba="1 0 0 1"
        mass="0.05"
        contype="1" conaffinity="1"
        friction="1.2 0.005 0.0001"
        solref="0.002 1"
        solimp="0.95 0.99 0.001"
        margin="0.001"
        priority="1"/>
        <site name="box_site" type="box" size="0.03 0.03 0.03" rgba="1 0 0 0"/>
        <site name="box_velocity_site" pos="0 0 0" size="0.03" rgba="0 0.2 1 0"/>
    </body>

    <geom name="wall1" class="wall_contact" type="box" size="0.01 0.2 0.05" pos="-0.75 0.7 0.21" rgba="0.2 0.2 0.8 0"/>

    <body pos="0.75 0.7 0.21" >
      <geom name="wall2" class="wall_contact" type="box" size="0.01 0.2 0.05" rgba="1 1 1 0.1"/>
    </body>

    <body name="overhead_camera_body" pos="0.4 0.65 0.95">
      <geom type="box" size="0.04 0.03 0.02" rgba="0.25 0.25 0.25 1" contype="0" conaffinity="0"/>
      <camera name="overhead_cam" mode="fixed" pos="0 0 0" xyaxes="1 0 0 0 1 0" fovy="45" resolution="640 480"/>
    </body>

    <body name="drop_box" pos="-0.5 0.32 0.01">
    <!-- Box floor -->
      <geom type="box" size="0.12 0.12 0.005" rgba="0.6 0.4 0.2 0.8"  contype="1" conaffinity="1"
        friction="1.2 0.005 0.0001" solref="0.002 1" solimp="0.95 0.99 0.001" margin="0.001" gap="0"/>
      <!-- Front wall (Y+) -->
      <geom type="box" size="0.12 0.005 0.05" pos="0 0.12 0.05" rgba="0.6 0.4 0.2 0.8" friction="0.8 0.005 0.001"/>
      <!-- Back wall (Y-) -->
      <geom type="box" size="0.12 0.005 0.05" pos="0 -0.12 0.05" rgba="0.6 0.4 0.2 0.8" friction="0.8 0.005 0.001"/>
      <!-- Left wall (X-) -->
      <geom type="box" size="0.005 0.12 0.05" pos="-0.12 0 0.05" rgba="0.6 0.4 0.2 0.8" friction="0.8 0.005 0.001"/>
      <!-- Right wall (X+) -->
      <geom type="box" size="0.005 0.12 0.05" pos="0.12 0 0.05" rgba="0.6 0.4 0.2 0.8" friction="0.8 0.005 0.001"/>
    </body>

<!--    <body name="small_box_body" pos="0 0 -1">-->
<!--      <freejoint name="small_box_joint"/>-->
<!--      <geom name="small_box_geom" type="box" size="0.03 0.03 0.03"-->
<!--        rgba="0.9 0.1 0.1 1" mass="0.05" friction="1 0.5 0.01"/>-->
<!--    </body>-->

<!--&lt;!&ndash; Ball &ndash;&gt;-->
<!--    <body name="ball_body" pos="0 0 -1">-->
<!--      <freejoint name="ball_joint"/>-->
<!--      <geom name="ball_geom" type="sphere" size="0.035"-->
<!--            rgba="0.9 0.15 0.1 1" mass="0.05" friction="1 0.5 0.01"/>-->
<!--    </body>-->


  </worldbody>

  <equality>


    <weld body1="base_mount" body2="wrist_3_link"
          anchor="0 0.1 0"
          relpose="0 0 0 0.707 0.707 0 0"
          solref="0.01 1"
          solimp="0.9 0.95 0.001"/>
  </equality>

   <sensor>
     <framelinvel name="vel2" objtype="site" objname="box_velocity_site"/>
     <velocimeter name="box_velocity" site="box_velocity_site"/>
     <touch name="collisions" site="box_site"/>

  </sensor>

  <actuator>
    <velocity name="box_velocity" joint="box_joint" ctrlrange="-20 20"/>
  </actuator>

  <contact>
<!--    <pair geom1="box_geom" geom2="wall1" solref="0.05 0.1" solimp="0.95 0.99 0.001"/>-->
<!--    <pair geom1="box_geom" geom2="wall2" solref="0.05 0.1" solimp="0.95 0.99 0.001"/>-->

    <exclude body1="base_mount" body2="wrist_3_link"/>
    <exclude body1="base2"      body2="wrist_3_link"/>
    <exclude body1="base_mount" body2="wrist_2_link"/>
    <exclude body1="base2"      body2="wrist_2_link"/>
    <exclude body1="base2"      body2="forearm_link"/>
  </contact>


</mujoco>
